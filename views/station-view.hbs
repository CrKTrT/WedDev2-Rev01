{{> menu active="station"}}

<section class="section">

  <div class="title">
    {{station.name}}
  </div>

  {{!-- Summary Cards --}}
  {{#if latest}}
    {{> station-summary}}
  {{else}}
    <p>No reports yet. Add your first report below.</p>
  {{/if}}

  <hr>
  {{> list-reports}}
  <hr>

  {{> add-reports}}
</section>
