<table class="table is-fullwidth is-striped is-hoverable">
  <thead>
    <tr>
      <th>Date / Time</th>
      <th>Code</th>
      <th>Temp (°C)</th>
      <th>Wind (km/h)</th>
      <th>Direction</th>
      <th>Pressure (hPa)</th>
      <th>Icon</th>
      <th></th>
    </tr>
  </thead>

  <tbody>
    {{#each ../reports}}
      <tr>
        <td>{{time}}</td>

        <td>{{code}}</td>

        <!-- Ensure ° symbol displays correctly -->
        <td>{{temp}} °C</td>

        <!-- Remove long decimals via Handlebars helper -->
        <td>{{toFixed windSpeed 2}} km/h</td>

        <td>{{windDirection}}°</td>

        <td>{{pressure}}</td>

        <!-- Correct icon logic -->
        <td>
          {{#if icon}}
            <img src="https://openweathermap.org/img/wn/{{icon}}@2x.png" alt="Weather Icon">
          {{else}}
            <span>No icon</span>
          {{/if}}
        </td>

        <td>
          <a href="/station/{{../station._id}}/deletereport/{{_id}}"
             class="button is-danger is-small">
            Delete
          </a>
        </td>
      </tr>
    {{/each}}
  </tbody>
</table>


