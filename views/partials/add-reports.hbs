<form class="box" action="/station/{{station._id}}/addreport" method="POST">
  <label>Enter Weather Reading:</label>

  <div class="field is-horizontal">
    <div class="field-body">

      <div class="field">
        <input class="input" type="number" placeholder="Weather Code" name="code" required>
      </div>

      <div class="field">
        <input class="input" type="number" step="0.1" placeholder="Temp (°C)" name="temp" required>
      </div>

      <div class="field">
        <input class="input" type="number" step="0.1" placeholder="Wind Speed" name="windSpeed" required>
      </div>

      <div class="field">
        <input class="input" type="text" placeholder="Wind Direction" name="windDirection" required>
      </div>

      <div class="field">
        <input class="input" type="number" placeholder="Pressure (hPa)" name="pressure" required>
      </div>

    </div>
  </div>

  <button class="button is-primary">Add Report</button>
</form>
