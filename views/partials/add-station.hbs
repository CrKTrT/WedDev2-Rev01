<form class="section box" action="/dashboard/addstation" method="POST">
  <div class="field">
    <label class="label">Station Name</label>
    <input class="input" type="text" placeholder="Enter station name" name="name">
  </div>

  <div class="field">
    <label class="label">Latitude</label>
    <input class="input" type="number" step="0.0001" placeholder="Enter latitude" name="lat" required>
  </div>

  <div class="field">
    <label class="label">Longitude</label>
    <input class="input" type="number" step="0.0001" placeholder="Enter longitude" name="lng" required>
    </div>
  
  <button class="button is-link">Add Station</button>
</form>